# Supabase — ambil dari Project Settings > API di dashboard Supabase kamu
# Anon key AMAN dipakai di browser (dibatasi oleh Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Key — RAHASIA, JANGAN PERNAH pakai prefix NEXT_PUBLIC_.
# Hanya dipakai di server (src/lib/supabaseAdmin.ts & API routes).
# Kalau ini bocor ke browser, RLS bisa di-bypass sepenuhnya.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Sheets Backup — RAHASIA, JANGAN PERNAH pakai prefix NEXT_PUBLIC_.
# Lihat DEPLOY.md bagian "Setup Google Sheets Backup" untuk cara membuatnya.
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"
